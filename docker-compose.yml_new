version: '3.8'

services:
  # ... (Alle anderen Dienste bleiben exakt wie in deiner Zusammenfassung!)
  postgres:
    image: postgres:15-alpine
    environment:
      POSTGRES_DB: meeting_db
      POSTGRES_USER: meeting_user
      POSTGRES_PASSWORD: meeting_password
    volumes:
      - postgres_data:/var/lib/postgresql/data
    ports:
      - "5432:5432"
    networks:
      default:
        aliases:
          - postgres

  # ... (Andere Infrastruktur-Container)

  frontend:
    build: ./frontend
    ports:
      - "3000:80"
    volumes:
      - ./frontend/dist:/usr/share/nginx/html:ro
      # Wir mounten deine funktionierende Nginx-Config aus dem Projekt
      - ./frontend/nginx.conf:/etc/nginx/conf.d/default.conf:ro
    depends_on:
      - backend

# ... Rest der docker-compose.yml bleibt konsistent
