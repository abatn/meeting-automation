      "parameters": {
        "jsCode": "const data = $input.first().json;\nconst body = data.body || {};\nconst attendees = body.attendees || [];\nconst toEmail = Array.isArray(attendees) ? attendees.join(',') : String(attendees);\nif (!toEmail) throw new Error('No attendees found in payload');\nreturn { json: { ...data, toEmail: toEmail } };"
