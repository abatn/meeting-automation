{
  "id": "4",
  "name": "Daily Reminders Automation",
  "nodes": [
    {
      "parameters": {
        "triggerTimes": {
          "item": [
            {
              "hour": 8
            }
          ]
        }
      },
      "id": "cron-trigger-node",
      "name": "Cron Trigger",
      "type": "n8n-nodes-base.cron",
      "typeVersion": 1,
      "position": [
        100,
        300
      ]
    },
    {
      "parameters": {
        "url": "http://meeting-automation-backend-1:8000/api/v1/actions/pending",
        "method": "GET",
        "authentication": "none",
        "sendHeaders": true,
        "headerParameters": {
           "parameters": [
             {
               "name": "X-Internal-API-Key",
               "value": "=internal-api-key-default"
             }
           ]
        },
        "options": {
          "maxRetries": 3,
          "retryWait": "exponential"
        },
        "continueOnFail": true
      },
      "name": "Get Pending Actions",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [
        300,
        300
      ]
    },
    {
      "parameters": {
        "jsCode": "const actions = $input.first().json;\nif (!Array.isArray(actions)) {\n  return actions.map(action => ({\n    json: {\n      ...action,\n      due_date: action.due_date || null,\n      assignee_phone: action.assignee_phone || null,\n      manager_email: action.manager_email || null,\n      assignee_name: action.assignee_name || 'Unknown',\n      title: action.title || 'Action Item'\n    }\n  }));\n}\nreturn [];"
      },
      "id": "enrich-actions",
      "name": "Enrich Actions Data",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        410,
        300
      ]
    },
    {
      "parameters": {
        "conditions": {
          "dateTime": [
            {
              "value1": "={{new Date($json.due_date).getTime()}}",
              "value2": "={{$now.getTime()}}"
            }
          ]
        }
      },
      "name": "Is Due Today?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [
        500,
        300
      ]
    },
    {
       "parameters": {
         "url": "=https://graph.facebook.com/v18.0/YOUR_WHATSAPP_PHONE_ID/messages",
        "method": "POST",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "bodyParameters": {
          "parameters": [
            {
              "name": "messaging_product",
              "value": "whatsapp"
            },
            {
              "name": "to",
              "value": "={{$json.assignee_phone}}"
            },
            {
              "name": "type",
              "value": "text"
            },
            {
              "name": "text",
              "value": "={{ { body: 'Reminder: Your action item ' + $json.title + ' is due today!' } }}"
            }
          ]
        },
        "options": {
          "maxRetries": 3,
          "retryWait": "exponential"
        },
        "continueOnFail": true
      },
      "name": "WhatsApp Reminder",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [
        750,
        200
      ],
      "credentials": {
        "httpHeaderAuth": {
          "id": "3",
          "name": "WhatsApp Token"
        }
      }
    },
    {
      "parameters": {
        "resource": "email",
        "operation": "send",
        "fromEmail": "escalations@meeting-automation.tn",
        "toEmail": "={{$json[\"manager_email\"]}}",
        "subject": "=Action Item Escalation: {{$json[\"title\"]}}",
        "text": "=The following action item is overdue: {{$json[\"title\"]}}. Assigned to: {{$json[\"assignee_name\"]}}.",
        "options": {}
      },
      "name": "Escalate to Manager",
      "type": "n8n-nodes-base.emailSend",
      "typeVersion": 2.1,
      "position": [
        750,
        400
      ],
      "credentials": {
        "smtp": {
          "id": "Z4QPw36ZE0HkHiHP",
          "name": "SMTP account"
        }
      }
    }
  ],
  "connections": {
    "Cron Trigger": {
      "main": [
        [
          {
            "node": "Get Pending Actions",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Get Pending Actions": {
      "main": [
        [
          {
            "node": "Enrich Actions Data",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Enrich Actions Data": {
      "main": [
        [
          {
            "node": "Is Due Today?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Is Due Today?": {
      "main": [
        [
          {
            "node": "WhatsApp Reminder",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Escalate to Manager",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": true,
  "settings": {}
}
